# Flask environment (development | testing | production)
FLASK_ENV=development
FLASK_DEBUG=1

# Secret keys – MUST be changed in production
SECRET_KEY=change-me-in-production
JWT_SECRET_KEY=jwt-change-me-in-production

# PostgreSQL / Supabase connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/construction_erp

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Server port (default 5000)
PORT=5000
